{
  "name": "@soleone/keyreps",
  "version": "0.1.2",
  "description": "A terminal game for learning Unix and Readline keyboard shortcuts",
  "type": "module",
  "bin": {
    "keyreps": "dist/src/cli.js"
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/src/cli.js",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "release": "release-it",
    "start": "node dist/src/cli.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc --noEmit",
    "demo:build": "npm run build && showcase-terminal demo/browser --out dist/browser",
    "demo": "npm run build && showcase-terminal demo/browser --out dist/browser --serve",
    "media:capture": "node demo/capture.mjs"
  },
  "keywords": [
    "cli",
    "terminal",
    "game",
    "readline",
    "unix",
    "keyboard-shortcuts"
  ],
  "author": "Soleone <dev@soleone.xyz>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=10",
      "onFail": "warn"
    }
  },
  "devDependencies": {
    "@soleone/showcase-capture": "^0.1.0",
    "@soleone/showcase-terminal": "^0.1.0",
    "@types/node": "^22.0.0",
    "release-it": "^21.1.0",
    "typescript": "^5.6.0"
  },
  "release-it": {
    "hooks": {
      "before:init": "npm test"
    },
    "npm": {
      "stage": true
    }
  }
}
