{
  "name": "typegod",
  "version": "0.1.0",
  "description": "A terminal game for learning Unix and Readline keyboard shortcuts",
  "type": "module",
  "bin": {
    "typegod": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/src/cli.js",
    "start": "node dist/src/cli.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
